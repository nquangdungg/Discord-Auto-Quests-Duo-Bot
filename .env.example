# ====================== BOT TOKENS ======================
BOT1_TOKEN=your_user_facing_bot_token_here
BOT2_TOKEN=your_admin_bot_token_here

# ====================== CLIENT IDs (for slash command register) ======================
BOT1_CLIENT_ID=
BOT2_CLIENT_ID=

# ====================== OWNER ======================
# Discord User ID of the absolute owner (only this ID can use /rejecto)
OWNER_ID=123456789012345678

# ====================== INITIAL ADMIN SERVER ======================
# Comma-separated Guild IDs that Bot 02 is allowed to stay in from the first start.
# Example: INITIAL_GUILD_IDS=123456789012345678,987654321098765432
# If empty and Bot 02 is already in a server on first run, that server is auto-whitelisted once.
INITIAL_GUILD_IDS=

# ====================== SECURITY ======================
# 32-byte (64 hex chars) encryption key for tokens & license keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

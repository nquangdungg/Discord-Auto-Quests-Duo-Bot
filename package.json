{
  "name": "hieutool-bot",
  "version": "1.0.1",
  "description": "Educational Discord Dual-Bot System for Quest Automation (Learning Purpose Only)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "register": "tsx --env-file=.env src/register-commands.ts",
    "test:smoke": "tsx --env-file=.env scripts/smoke-test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
